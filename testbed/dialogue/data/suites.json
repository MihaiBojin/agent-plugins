{
  "default": [
    "baseline",
    "comms",
    "style",
    "situation",
    "signals",
    "threads",
    "conflicts",
    "workflows",
    "commands"
  ],
  "suites": {
    "baseline": {
      "about": "Plugin installed and disabled, against the base configuration, on every task scenario",
      "configs": ["disabled", {}],
      "scenarios": ["*"]
    },
    "comms": {
      "about": "Each communication profile",
      "vary": "comms",
      "scenarios": [
        "routine-question",
        "implemented",
        "compare",
        "code-change",
        "decisions"
      ]
    },
    "style": {
      "about": "Each language style",
      "vary": "style",
      "scenarios": ["routine-question", "procedure", "code-change", "compare"]
    },
    "situation": {
      "about": "Each situational framework, including one ordinary question",
      "vary": "situation",
      "scenarios": [
        "routine-question",
        "escalation",
        "handoff",
        "status",
        "safety",
        "incident"
      ]
    },
    "signals": {
      "about": "Each signaling mode",
      "vary": "signals",
      "scenarios": [
        "routine-question",
        "ownership",
        "safety",
        "escalation",
        "decisions"
      ]
    },
    "threads": {
      "about": "Each thread mode: focus and compact on and off, and threads off",
      "vary": "threads",
      "scenarios": ["decisions", "markers", "walk", "focus-drift", "compare"]
    },
    "conflicts": {
      "about": "Rules that conflict or repeat when two settings meet",
      "configs": [
        { "style": "ste", "threads": "off" },
        { "style": "ste", "situation": "ipass", "signals": "intent" }
      ],
      "scenarios": ["procedure", "handoff", "safety"]
    },
    "workflows": {
      "about": "The setup workflows, each a situation and signals pair",
      "workflows": true,
      "scenarios": ["routine-question", "ownership", "escalation", "handoff"]
    },
    "commands": {
      "about": "The dialogue commands, typed by the user in the conversation",
      "cases": [
        { "scenario": "cmd-setup", "config": {} },
        { "scenario": "cmd-enable", "config": "disabled" },
        { "scenario": "cmd-disable", "config": {} },
        { "scenario": "cmd-stop-words", "config": {} },
        { "scenario": "cmd-set-midway", "config": {} },
        { "scenario": "cmd-situation-once", "config": {} },
        { "scenario": "cmd-guideline", "config": {} },
        { "scenario": "cmd-inspect", "config": {} }
      ]
    },
    "noise": {
      "about": "Opt-in. Run with --repeat 3: the spread between repeats of one configuration, against which a difference between configurations is measured",
      "configs": ["disabled", {}],
      "scenarios": [
        "routine-question",
        "implemented",
        "compare",
        "procedure",
        "handoff",
        "decisions"
      ]
    },
    "ablation": {
      "about": "Opt-in. Run with --repeat 3. The reference has every guideline on; each other configuration removes one guideline, or one rule line of the thread protocol, and ablation.md shows what changed",
      "leave_one_out": {
        "name": "ref",
        "reference": {
          "comms": "pyramid",
          "style": "ste",
          "situation": "none",
          "signals": "intent",
          "threads": "focus-compact",
          "all_guidelines": true
        },
        "units": [
          {
            "kind": "guidelines",
            "scenarios": [
              "routine-question",
              "implemented",
              "compare",
              "procedure",
              "code-change",
              "escalation"
            ]
          },
          {
            "kind": "lines",
            "file": "policy/threads.md",
            "scenarios": ["decisions", "markers", "walk", "compare"]
          }
        ]
      }
    },
    "ablation-groups": {
      "about": "Opt-in. Run with --repeat 6. The ablation reference; each other configuration removes one type of guideline, or one paragraph of the thread protocol",
      "leave_one_out": {
        "name": "ref",
        "reference": {
          "comms": "pyramid",
          "style": "ste",
          "situation": "none",
          "signals": "intent",
          "threads": "focus-compact",
          "all_guidelines": true
        },
        "units": [
          {
            "kind": "guidelines",
            "group": true,
            "scenarios": [
              "routine-question",
              "implemented",
              "compare",
              "procedure",
              "code-change",
              "escalation"
            ]
          },
          {
            "kind": "lines",
            "file": "policy/threads.md",
            "group": true,
            "scenarios": ["decisions", "markers", "walk", "compare"]
          }
        ]
      }
    },
    "guidelines": {
      "about": "Opt-in. The custom profile with exactly one guideline turned on, for each guideline",
      "ablate": "custom",
      "scenarios": ["routine-question", "compare", "procedure"]
    },
    "full": {
      "about": "Opt-in with --full. Every combination of the five settings, on every task scenario",
      "product": true,
      "scenarios": ["*"]
    }
  }
}
