#!/usr/bin/env bash
#
# A fake `glab`, matching the real one's flags closely enough that a change to
# lib/forge.sh which breaks GitLab breaks a test here.

set -euo pipefail
printf 'glab %s\n' "$*" >>"${ORIGIN_STUB_LOG:-/dev/null}"
printf '%s\n' "${GITLAB_REPO:-}" >"${ORIGIN_STUB_DIR}/glab-context"

canned() {
  local file="${ORIGIN_STUB_DIR}/${1}"
  [ -r "$file" ] || {
    printf 'no such %s\n' "$1" >&2
    exit 1
  }
  cat "$file"
}

jq_filter() {
  local previous='' argument
  for argument in "$@"; do
    if [ "$previous" = "--jq" ]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf ''
}

# The value after `--hostname`, if any. Not `${*##*--hostname }`: with $* the
# pattern is applied to each positional parameter, not to the joined string.
hostname_arg() {
  local previous='' argument
  for argument in "$@"; do
    if [ "$previous" = "--hostname" ]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf ''
}

emit() {
  local filter
  filter="$(jq_filter "$@")"
  if [ -n "$filter" ]; then
    jq -r "$filter"
  else
    cat
  fi
}

[ "${ORIGIN_STUB_GLAB_UNAUTHENTICATED:-0}" = 1 ] && {
  printf 'Not logged in.\n' >&2
  exit 1
}

case "${1:-}" in
  auth)
    # `auth status [--hostname H]` succeeds for this CLI's own public host and
    # for whatever host a test says it is signed in to.
    case " $* " in
      *" --hostname "*)
        want="$(hostname_arg "$@")"
        case "$want" in
          gitlab.com|gitlab.*) exit 0 ;;
        esac
        [ "$want" = "${ORIGIN_STUB_HOST:-}" ] && exit 0
        exit 1
        ;;
      *) exit 0 ;;
    esac
    ;;
  api)
    case "${2:-}" in
      projects/*/pipelines/*/jobs*) canned jobs.json | emit "$@" ;;
      projects/*/pipelines/*) canned pipeline.json | emit "$@" ;;
      projects/*/repository/commits/*) canned pipeline-commit.json | emit "$@" ;;
      projects/*/repository/branches/*) canned pipeline-base.json | emit "$@" ;;
      *) canned api.json | emit "$@" ;;
    esac
    ;;
  mr)
    case "${2:-}" in
      view)
        if [ -n "${ORIGIN_STUB_GLAB_VIEW_THEN:-}" ] && [ -e "${ORIGIN_STUB_DIR}/.mr-viewed" ]; then
          canned "$ORIGIN_STUB_GLAB_VIEW_THEN" | emit "$@"
        else
          : >"${ORIGIN_STUB_DIR}/.mr-viewed"
          canned mr.json | emit "$@"
        fi
        ;;
      list) canned mr-list.json | emit "$@" ;;
      update)
        # `--ready` on a draft, the GitLab spelling. Same shape as the gh stub:
        # mr-ready.json when a test wrote one, otherwise the flag is cleared.
        if [ -r "${ORIGIN_STUB_DIR}/mr-ready.json" ]; then
          cp "${ORIGIN_STUB_DIR}/mr-ready.json" "${ORIGIN_STUB_DIR}/mr.json"
        else
          jq '.draft = false | .work_in_progress = false' "${ORIGIN_STUB_DIR}/mr.json" >"${ORIGIN_STUB_DIR}/mr.json.new"
          mv "${ORIGIN_STUB_DIR}/mr.json.new" "${ORIGIN_STUB_DIR}/mr.json"
        fi
        exit 0
        ;;
      merge)
        printf 'Merged\n'
        exit 0
        ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
