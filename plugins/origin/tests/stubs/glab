#!/usr/bin/env bash
#
# A fake `glab`, matching the real one's flags closely enough that a change to
# lib/forge.sh which breaks GitLab breaks a test here.

set -euo pipefail
printf 'glab %s\n' "$*" >>"${ORIGIN_STUB_LOG:-/dev/null}"

canned() {
  local file="${ORIGIN_STUB_DIR}/${1}"
  [ -r "$file" ] || {
    printf 'no such %s\n' "$1" >&2
    exit 1
  }
  cat "$file"
}

jq_filter() {
  local previous='' argument
  for argument in "$@"; do
    if [ "$previous" = "--jq" ]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf ''
}

# The value after `--hostname`, if any. Not `${*##*--hostname }`: with $* the
# pattern is applied to each positional parameter, not to the joined string.
hostname_arg() {
  local previous='' argument
  for argument in "$@"; do
    if [ "$previous" = "--hostname" ]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf ''
}

emit() {
  local filter
  filter="$(jq_filter "$@")"
  if [ -n "$filter" ]; then
    jq -r "$filter"
  else
    cat
  fi
}

[ "${ORIGIN_STUB_GLAB_UNAUTHENTICATED:-0}" = 1 ] && {
  printf 'Not logged in.\n' >&2
  exit 1
}

case "${1:-}" in
  auth)
    # `auth status [--hostname H]` succeeds for this CLI's own public host and
    # for whatever host a test says it is signed in to.
    case " $* " in
      *" --hostname "*)
        want="$(hostname_arg "$@")"
        case "$want" in
          gitlab.com|gitlab.*) exit 0 ;;
        esac
        [ "$want" = "${ORIGIN_STUB_HOST:-}" ] && exit 0
        exit 1
        ;;
      *) exit 0 ;;
    esac
    ;;
  api) canned api.json | emit "$@" ;;
  mr)
    case "${2:-}" in
      view) canned mr.json | emit "$@" ;;
      list) canned mr-list.json | emit "$@" ;;
      merge)
        printf 'Merged\n'
        exit 0
        ;;
      *) exit 1 ;;
    esac
    ;;
  *) exit 1 ;;
esac
