#!/usr/bin/env bash
#
# origin - starting a branch, keeping it on top of the head branch, and merging
# its pull request, from one CLI that both a person and an agent can run.

set -euo pipefail

# shellcheck source-path=SCRIPTDIR/..

# This file's directory, through however many symlinks an install put in the
# way. `readlink -f` is not on every mac.
origin_self() {
  local source="${BASH_SOURCE[0]}" directory
  while [ -L "$source" ]; do
    directory="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="${directory}/${source}" ;;
    esac
  done
  cd -P "$(dirname "$source")" && pwd
}

ORIGIN_ROOT="$(dirname "$(origin_self)")"
export ORIGIN_ROOT

# shellcheck source=SCRIPTDIR/../lib/common.sh
. "${ORIGIN_ROOT}/lib/common.sh"
# shellcheck source=SCRIPTDIR/../lib/repo.sh
. "${ORIGIN_ROOT}/lib/repo.sh"
# shellcheck source=SCRIPTDIR/../lib/forge.sh
. "${ORIGIN_ROOT}/lib/forge.sh"
# shellcheck source=SCRIPTDIR/../lib/merged.sh
. "${ORIGIN_ROOT}/lib/merged.sh"
# shellcheck source=SCRIPTDIR/../lib/merge.sh
. "${ORIGIN_ROOT}/lib/merge.sh"
# shellcheck source=SCRIPTDIR/../lib/sync.sh
. "${ORIGIN_ROOT}/lib/sync.sh"
# shellcheck source=SCRIPTDIR/../lib/new.sh
. "${ORIGIN_ROOT}/lib/new.sh"

usage() {
  cat >&2 <<'HELP'
origin - a branch, on top of the head branch, and the pull request it becomes

USAGE
  origin <command> [flags]

COMMANDS
  new <name>                     Fetch, then branch <name> off the head branch
  sync                           Fetch, rebase onto the head branch, push with a lease
  merge [<number>]               Merge a pull request with a written body
  help                           This

EVERYWHERE
  --dry-run    Say what would happen, and do none of it
  --yes        Do not ask; nothing reads from a terminal
  --quiet      No commentary; data and errors only
  --verbose    Print each command before running it
  --no-color   Plain text

WHAT IT WILL NOT DO
  No `git reset --hard`, no `git clean --force`, no bare `--force` push, no
  force delete of a branch nothing has proved merged. No flag reaches these,
  `--yes` included, and nothing here resolves a conflict for you.

WORKTREES
  Not here. `gwa`, `gwr`, `gwl` and `gwm` are shell commands, from
  https://github.com/MihaiBojin/shell-plugins

CONFIGURATION
  git config checkout.defaultRemote <name>     Which remote this repo belongs to
  git remote set-head <remote> --auto          Record which branch is the default
HELP
}

main() {
  [ "$#" -gt 0 ] || {
    usage
    exit 1
  }

  local command="$1"
  shift

  case "$command" in
    new | nb) new_main "$@" ;;
    sync) sync_main "$@" ;;
    merge) merge_main "$@" ;;
    help | -h | --help) usage ;;
    version | -V | --version) printf 'origin %s\n' "$(origin_version)" ;;
    *) die "there is no '${command}' command; run 'origin --help'" ;;
  esac
}

main "$@"
