{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dialogue\" --client codex hook",
            "timeout": 15,
            "additionalContextLimit": 16000
          }
        ]
      }
    ]
  }
}
